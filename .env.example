# Environment Variables Example for Gujarat Police Sentinel

# Official Sentinel Camera Grid Integration
SENTINEL_HLS_HOST=https://cctv.corp8.cloud
SENTINEL_RTSP_HOST=103.250.160.189
SENTINEL_RTSP_PORT=8554
SENTINEL_WHEP_HOST=http://103.250.160.189:8889
SENTINEL_CATALOG_URL=https://cctv.corp8.cloud/cameras.json
SENTINEL_HLS_PASSWORD=

# Backend & API Configuration
API_PORT=8000
API_HOST=0.0.0.0
JWT_SECRET=super_secret_jwt_key_change_in_production_gujarat_police_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (PostgreSQL + PostGIS)
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_secure_pass_2026
POSTGRES_DB=sentinel_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel_secure_pass_2026@localhost:5432/sentinel_db

# Redis Cache & Message Broker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Streaming Gateway Configuration
RTSP_TRANSPORT=tcp
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_WEBRTC_PORT=8889

# AI Worker Configuration
YOLO_MODEL_PATH=yolov8n.pt
ANPR_OCR_ENGINE=paddleocr
ENABLE_GPU=true
MIN_PLATE_CONFIDENCE=0.75

# Pipeline & Stream Resource Limits (tune for your hardware)
MAX_CONCURRENT_STREAMS=4
STREAM_FRAME_QUEUE_SIZE=2
STREAM_INGEST_INTERVAL_SEC=0.2
STREAM_MAX_FRAME_WIDTH=640
STREAM_START_STAGGER_SEC=0.75
PIPELINE_FRAME_WIDTH=640
YOLO_IMGSZ=640
YOLO_ENABLE_TILING=false
YOLO_CONFIDENCE=0.25
ENABLE_LIVE_PIPELINE=true
